{
  "presetId": "ocean-merge-level-voyage-v46",
  "source": {
    "projectId": "appgprj_6ad7bc4e2968819182f092870e93ad0d",
    "publishedVersion": 46,
    "commit": "98314a727d9a0812c60c5e606c3d313a3d0e68a7",
    "verifiedOn": "2026-10-24",
    "scope": "Current published code and default settings; no access to personal device localStorage."
  },
  "settings": {
    "swell": 85,
    "light": 65,
    "sound": false,
    "quality": "auto",
    "mode": "ripple",
    "swellDefaultRevision": 2
  },
  "reducedMotion": {
    "respectSystemPreference": true,
    "defaultSwell": 12,
    "boatBob": false,
    "boatWake": false,
    "ambientImpulses": false,
    "fingerStrengthMultiplier": 0.45
  },
  "rendering": {
    "engine": "WebGL2",
    "floatStateExtension": "EXT_color_buffer_float",
    "fallback": "Original CanvasSurface (simplified, not visually identical to WebGL2)",
    "coastTexture": "./assets/coast-no-tent-v4.png",
    "initialOceanTravel": 0,
    "textureTravel": "scrollTop / max(400, fullWorldHeight) * 0.34",
    "oceanUv": {
      "imageAspect": 0.6666666666666666,
      "x": "(uv.x - 0.5) * min(1, viewportAspect / (2/3)) + 0.5",
      "q": "uv.y * 0.86 + oceanTravel",
      "mirror": "1 - abs(mod(q, 2) - 1)",
      "sceneY": "0.43 + mirror * 0.59"
    },
    "devicePixelRatioCap": {
      "auto": 1.5,
      "high": 2,
      "eco": 1
    },
    "frameDtMaxSeconds": 0.04
  },
  "simulation": {
    "stateFormat": "RG16F",
    "doubleBuffered": true,
    "stepSeconds": 0.016666666666666666,
    "accumulatorCapSeconds": 0.05,
    "gridWidth": {
      "auto": 192,
      "high": 240,
      "eco": 128
    },
    "gridHeight": "min(512, round(gridWidth * height / width))",
    "stencil": "next = (left + right + up + down) * 0.5 - previousHeight",
    "edgeDamping": 0.92,
    "interiorDamping": 0.993,
    "edgeBlendWidthUv": 0.045,
    "heightClamp": [
      -0.8,
      0.8
    ],
    "dropKernel": "(cos(distanceInGridCells / radius * PI) + 1) * 0.5 * amplitude, inside radius only",
    "maxDropsPerStep": 12,
    "maxPendingDrops": 48,
    "dropCoordinateClamp": [
      0.005,
      0.995
    ],
    "gradientGain": 4.5,
    "curvatureGain": 75,
    "radiusUnits": "simulation-grid cells; not CSS pixels"
  },
  "analyticSwell": {
    "wind": "settings.swell / 100",
    "energy": "(0.08 + wind * 1.8) * 1.22",
    "vectors": [
      [
        10,
        21
      ],
      [
        -25,
        14
      ],
      [
        49,
        -31
      ],
      [
        -76,
        -39
      ]
    ],
    "angularSpeed": [
      1.45,
      1.83,
      2.47,
      3.15
    ],
    "amplitude": [
      0.0048,
      0.0026,
      0.0008,
      0.00036
    ],
    "refractionGain": 0.022,
    "driftGain": 0.018
  },
  "surf": {
    "periodSeconds": 7.6,
    "gain": 1.85,
    "crestWidthGain": 1.5,
    "swellGain": 1.22,
    "phase": "fract(time / 7.6)",
    "offshore": "0.58 * (1 - clamp(phase / 0.48, 0, 1)) ** 1.15",
    "lobes": [
      {
        "amplitude": 0.03,
        "frequency": 7.2,
        "drift": 0.13,
        "phase": 1.4
      },
      {
        "amplitude": 0.014,
        "frequency": 17.6,
        "drift": -0.19,
        "phase": 0.8
      },
      {
        "amplitude": 0.006,
        "frequency": 33.5,
        "drift": 0.23,
        "phase": 2.4
      }
    ],
    "canonicalImplementation": "surf.js + water.js; shader includes coast-dependent runup, backflow and broken foam."
  },
  "lighting": {
    "sunDirectionBeforeNormalization": [
      -0.32,
      0.46,
      1
    ],
    "refractionRatio": 0.75188,
    "depthRange": [
      0.14,
      0.36
    ],
    "causticDetailMipLevel": 4,
    "dynamicActivity": "clamp(length(dynamicGrad) * 3.5 + abs(height) * 1.5 + vortexMotion, 0, 1)",
    "morphStrength": "(0.86 + wind * 0.64 + activity * 1.55) * shoreFade",
    "flowNoiseScale": 6,
    "flowNoiseTime": [
      0.065,
      -0.055
    ],
    "worldFlow": "(noise - 0.5) * 0.086 + vec2(0.014, 0.026)",
    "flowClock": "time * (0.24 + wind * 0.075) + noise * 0.75",
    "phaseOffset": 0.5,
    "focusRange": [
      0.76,
      1.45
    ],
    "specularExponent": 125,
    "canonicalImplementation": "Complete original FRAGMENT shader in water.js; do not replace with a generic caustics overlay."
  },
  "ambientImpulses": {
    "intervalMs": 2100,
    "count": 12,
    "x": "(i + 0.5) / 12",
    "y": "0.91 + sin(x * 6 + renderer.time * 0.24) * 0.008",
    "amplitude": "(0.008 + swell * 0.00032) * (0.85 + 0.15 * sin(x * 7 + renderer.time))",
    "radius": 12,
    "enabledWhen": "not reducedMotion, swell > 3, calmUntil elapsed"
  },
  "scroll": {
    "nativePhysics": true,
    "passiveListeners": true,
    "preventDefault": false,
    "pointerCapture": false,
    "coordinates": "relative to the full sea/world container, not the scroll viewport",
    "sampleThrottleMs": 32,
    "minMovePx": 3,
    "interpolationStepPx": 24,
    "maxInterpolatedDrops": 4,
    "beginAmplitude": 0.1,
    "moveAmplitude": "0.12 + min(0.14, (distancePx + abs(wheelDeltaY) * 0.15) / 180)",
    "perDropAmplitude": "strength / sqrt(interpolationSteps)",
    "radius": 5.5,
    "touchSource": "native touchstart/touchmove; touch pointer events ignored to avoid duplicates",
    "pointerCancel": "native touch sampling continues during iOS scroll",
    "implementation": "voyage-touch.js + OceanScene.bindScrollSurface"
  },
  "boat": {
    "route": "Catmull-Rom; voyage-model.js, original angle and tangent math",
    "progress": "clamp(scrollTop / levelStep, 0, levelCount - 1)",
    "levelStepPx": "min(164, max(68, mapHeight * 0.27))",
    "paddingPx": "mapHeight * 0.22",
    "routeX": "(0.5 + sin(i * 1.55 - 0.35) * 0.16) * mapWidth",
    "movingThresholdProgressPerFrame": 0.00012,
    "turnResponsePerSecond": 12,
    "turnEase": "1 - exp(-dt * 12)",
    "reverseAngleDegrees": 180,
    "bobAmplitudePx": 1.6,
    "bobAngularSpeedPerMs": 0.0022,
    "bob": "sin(performanceNowMs * 0.0022) * 1.6",
    "sizePx": [
      45,
      100
    ],
    "usesItemMotionWake": false,
    "usesItemBuoyancy": false
  },
  "boatWake": {
    "intervalMs": 65,
    "amplitudeBase": 0.11,
    "amplitudeExtraMax": 0.13,
    "speedGain": 3,
    "amplitude": "0.11 + min(0.13, abs(progressDeltaPerFrame) * 3)",
    "radius": 4.5,
    "x": "boatPathPoint.x / fullWorldWidth",
    "y": "(mapTop + boatPathPoint.y - scrollTop) / fullWorldHeight",
    "trailOffsetInLevels": 0.25,
    "maxFoamParticles": 34,
    "foamLifetimeSeconds": 1.35,
    "foamDprCap": 1.5,
    "foamRgb": [
      239,
      255,
      242
    ],
    "foamOpacity": "max(0, (1 - ageSeconds / 1.35) * 0.47)",
    "foamEllipseCenter": "[side * (9 + age * 15), age * 7]",
    "foamEllipseRadii": "[4 + age * 6, 1.7 + age * 2]",
    "foamEllipseAngleRadians": "-side * 0.35",
    "foamSides": [
      -1,
      1
    ],
    "implementation": "ocean-map.js update(); original source in reference/voyage.js"
  },
  "appearance": {
    "sceneShade": "linear-gradient(#092e332b 0%,transparent 15%,transparent 65%,#005d7138 100%)",
    "mapShade": "linear-gradient(180deg,#024c5d80 0%,#036b7526 27%,transparent 53%,#00677926 76%,#034b6099 100%)",
    "wildlifeEnabled": true,
    "wildlifeImplementation": "wildlife.js + wildlife-assets.js + original fish/gull PNGs",
    "shorelineAndWorldCoordinates": "camera.js",
    "boatShadow": "drop-shadow(4px 7px 3px #00526566)",
    "firstPaintBackgroundSize": "100% 230%",
    "firstPaintBackgroundPosition": "center bottom"
  },
  "authority": "All numbers describe the shipped source. Original modules remain canonical; changing this JSON alone does not retune hardcoded shader or boat constants."
}
